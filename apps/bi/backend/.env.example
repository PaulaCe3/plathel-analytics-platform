APP_NAME=BI Multi-Industria
APP_ENV=development
API_PREFIX=/api/v1
DEFAULT_LOCALE=es-AR
FRONTEND_ORIGIN=http://localhost:3000
MAX_FILE_MB=20
MAX_ROWS=250000
MAX_COLUMNS=200
DATASET_TTL_MINUTES=60
DATASET_STORAGE_PATH=.data/sessions
PREVIEW_DEFAULT_ROWS=50
PREVIEW_MAX_ROWS=100
MAX_CUSTOM_DIMENSIONS=10
MAX_CUSTOM_MEASURES=5

PROFILE_SAMPLE_ROWS=20000
HEAVY_CONCURRENCY=2
ABSOLUTE_SESSION_TTL_MINUTES=240
REAPER_INTERVAL_SECONDS=120
UPLOADS_PER_HOUR=10
MAX_ACTIVE_SESSIONS=100
MAX_SESSIONS_PER_IP=10
TRUSTED_PROXY_IPS=[]
CORS_ORIGINS=[]
MAX_ZIP_ENTRIES=1000
MAX_ZIP_EXPANDED_MB=100
MAX_ZIP_RATIO=100
MULTIPART_OVERHEAD_BYTES=65536
